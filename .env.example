API_PORT=8000
WEB_PORT=3000
TRIBE_UPLOADS_DIR=./storage/uploads
TRIBE_RESULTS_DIR=./storage/analyses
TRIBE_CACHE_DIR=./storage/cache
TRIBE_ALLOWED_ORIGIN=http://localhost:3000
TRIBE_DEVICE=auto
TRIBE_MAX_VIDEO_SECONDS=60
TRIBE_MAX_UPLOAD_BYTES=250000000
TRIBE_POLL_INTERVAL_MS=2500
# Read from the environment or .env only; the launcher does not accept a token flag.
# Real downloads require gated access to facebook/tribev2 and upstream Hugging Face dependencies.
HUGGINGFACE_HUB_TOKEN=
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# --- Convex integration ---
# Public Convex deployment URL, consumed by the Next.js client. Populated
# automatically into apps/web/.env.local when you run `npx convex dev` in
# apps/web, but you can also set it here for reference.
NEXT_PUBLIC_CONVEX_URL=
# Convex `.convex.site` URL used by Convex Auth to validate JWTs. Also set
# automatically by `npx convex dev`; override only if your deployment URL is
# not discoverable from the local environment.
CONVEX_SITE_URL=
# Shared secret used by the FastAPI -> Convex service bridge (ConvexSyncService).
# Generate with `openssl rand -hex 32` and mirror the value into Convex with
# `npx convex env set CONVEX_SERVICE_SECRET <value>` so both sides agree.
CONVEX_SERVICE_SECRET=
# When true (recommended), FastAPI routers reject upload/analyze requests that
# do not include the Convex IDs minted by the client. Set to false only for
# local smoke tests that intentionally bypass Convex.
REQUIRE_CONVEX_IDS=true
