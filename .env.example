API_PORT=8000
WEB_PORT=3000
TRIBE_UPLOADS_DIR=./storage/uploads
TRIBE_RESULTS_DIR=./storage/analyses
TRIBE_CACHE_DIR=./storage/cache
TRIBE_ALLOWED_ORIGIN=http://localhost:3000
ANALYSIS_BACKEND=tribe
TRIBE_DEVICE=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro
TRIBE_MAX_VIDEO_SECONDS=60
TRIBE_MAX_UPLOAD_BYTES=250000000
TRIBE_POLL_INTERVAL_MS=2500
NEXT_PUBLIC_CONVEX_URL=
CONVEX_SITE_URL=
CONVEX_SERVICE_SECRET=
# Run `npx convex dev` once to configure a deployment and generate fresh `convex/_generated/*` files.
CONVEX_DEPLOYMENT=
# Read from the environment or .env only; the launcher does not accept a token flag.
# Real downloads require gated access to facebook/tribev2 and upstream Hugging Face dependencies.
HUGGINGFACE_HUB_TOKEN=
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
