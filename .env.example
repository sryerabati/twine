API_PORT=8000
WEB_PORT=3000
TRIBE_UPLOADS_DIR=./storage/uploads
TRIBE_RESULTS_DIR=./storage/analyses
TRIBE_CACHE_DIR=./storage/cache
TRIBE_ALLOWED_ORIGIN=http://localhost:3000
ANALYSIS_BACKEND=tribe
TRIBE_DEVICE=auto
GEMINI_API_KEY=
GEMINI_PLATFORM=developer
GEMINI_MODEL=gemini-2.5-pro
MIROFISH_BASE_URL=
MIROFISH_REPO_DIR=
MIROFISH_AUTO_START=false
MIROFISH_TIMEOUT_SECONDS=900
MIROFISH_POLL_SECONDS=3
MIROFISH_SIMULATION_MAX_ROUNDS=10
MIROFISH_LLM_API_KEY=
MIROFISH_LLM_BASE_URL=
MIROFISH_LLM_MODEL_NAME=
MIROFISH_VERTEX_PROJECT_ID=
MIROFISH_VERTEX_LOCATION=global
MIROFISH_ZEP_API_KEY=
EDITOR_AI_PROVIDER=gemini
NVIDIA_API_KEY=
NVIDIA_MODEL=google/gemma-3n-e4b-it
TRIBE_MAX_VIDEO_SECONDS=120
TRIBE_MAX_UPLOAD_BYTES=50000000
TRIBE_POLL_INTERVAL_MS=2500

# Convex integration:
# - `NEXT_PUBLIC_CONVEX_URL` is written automatically to `apps/web/.env.local`
#   by `npx convex dev`
# - `CONVEX_SITE_URL` and `CONVEX_SERVICE_SECRET` let FastAPI mirror upload/scan
#   lifecycle state back into Convex
# - `REQUIRE_CONVEX_IDS=true` makes `/api/upload` and `/api/analyze` reject
#   requests that bypass the Convex-created upload/scan rows
NEXT_PUBLIC_CONVEX_URL=
CONVEX_SITE_URL=
CONVEX_SERVICE_SECRET=
REQUIRE_CONVEX_IDS=true
# Run `npx convex dev` once to configure a deployment and generate fresh `convex/_generated/*` files.
CONVEX_DEPLOYMENT=
# Read from the environment or .env only; the launcher does not accept a token flag.
# Real downloads require gated access to facebook/tribev2 and upstream Hugging Face dependencies.
HUGGINGFACE_HUB_TOKEN=
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
